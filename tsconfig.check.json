{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": []
  },
  "include": [
    "assets/core/domain/**/*.ts",
    "assets/core/application/**/*.ts",
    "assets/core/events/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts"
  ]
}
